{
  "name": "fighting-game",
  "private": true,
  "version": "2.0.0",
  "description": "Dusk Duel: a small 2D fighting game on its own deterministic engine, with frame data and a training mode.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @screenshots",
    "screenshots": "playwright test --grep @screenshots",
    "bench": "node tools/bench.mjs",
    "framedata": "node tools/frame-data-table.mjs",
    "desync": "node tools/desync.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
