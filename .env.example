# Copy to .env for local overrides. Nothing here is secret: the server has
# no keys, no database and no accounts. Never commit a real .env.

# ── Server (npm start / npm run dev:server) ──────────────────────────
PORT=3000
# Origins allowed to connect (comma-separated, no trailing slash). Empty in
# development means the Vite dev and preview servers on localhost.
# Required in production, https only.
ALLOWED_ORIGINS=
# Behind a proxy: a header the edge sets and overwrites with the client IP
# (Render/Cloudflare: true-client-ip), or the number of proxy hops to trust
# in X-Forwarded-For.
CLIENT_IP_HEADER=
TRUST_PROXY_HOPS=0
MAX_ROOMS=300
MAX_CONNECTIONS_PER_IP=20
# How long a disconnected player's seat is held before a forfeit (ms).
RECONNECT_GRACE_MS=30000

# ── Client build (npm run build) ─────────────────────────────────────
# The matchmaking server's URL. In CI this comes from the repository
# variable GAME_SERVER_URL. Empty: online play is unavailable (the lab,
# CPU, versus, training and replays all still work).
VITE_SERVER_URL=
